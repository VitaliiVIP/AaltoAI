ANTHROPIC_API_KEY=sk-ant-...

# SMTP — defaults to a disposable Ethereal Email test mailbox (nothing is
# ever delivered to a real inbox; login at https://ethereal.email with these
# credentials to see everything "sent"). Swap in a real provider's SMTP
# credentials to send to real inboxes instead — nothing else changes.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Recourse Hiring Copilot <no-reply@example.com>
SMTP_WEB=https://ethereal.email/messages
