ANTHROPIC_API_KEY=sk-ant-...

# Email — recourse_screen/emailer.py picks the provider automatically:
# Mailgun if MAILGUN_API_KEY + MAILGUN_DOMAIN are set, otherwise SMTP.

# Mailgun (real delivery). MAILGUN_DOMAIN must be a domain actually verified
# in your Mailgun account, or their sandbox domain (sandboxXXXX.mailgun.org),
# which only delivers to recipients you've pre-authorized in the dashboard.
# MAILGUN_API_BASE only needs setting for an EU-region account
# (https://api.eu.mailgun.net/v3).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=https://api.mailgun.net/v3

# SMTP — fallback when Mailgun isn't configured. Defaults to a disposable
# Ethereal Email test mailbox (nothing is ever delivered to a real inbox;
# login at https://ethereal.email with these credentials to see everything
# "sent"). Swap in a real provider's SMTP credentials to send to real
# inboxes this way instead.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_WEB=https://ethereal.email/messages

# Shared by both providers.
SMTP_FROM=Recourse Hiring Copilot <no-reply@example.com>
